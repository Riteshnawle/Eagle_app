# Copy this file to .env and fill in your EmailJS credentials
# (Sign up free at https://www.emailjs.com)
#
# 1. Create an Email Service (connect Gmail/Outlook/SMTP) -> copy its Service ID
# 2. Create an Email Template with variables:
#    {{to_email}} {{form_type}} {{name}} {{email}} {{phone}} {{position}} {{message}} {{resume_link}}
#    Set the template's "To Email" field to {{to_email}}
# 3. Copy the Template ID and your account's Public Key
#
# Without these, forms still save to Firestore but no email is sent.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
